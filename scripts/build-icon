#!/bin/sh
set -eu
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
icons="$work/murdic.iconset"
mkdir "$icons"
for size in 16 32 128 256 512; do
    /usr/bin/sips -z "$size" "$size" "$1" --out "$icons/icon_${size}x${size}.png" >/dev/null
    retina=$((size * 2))
    /usr/bin/sips -z "$retina" "$retina" "$1" --out "$icons/icon_${size}x${size}@2x.png" >/dev/null
done
/usr/bin/iconutil -c icns "$icons" -o "$work/murdic.icns"
mv "$work/murdic.icns" "$2"
